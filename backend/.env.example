# Copy to backend/.env and adjust as needed.

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./data/nuzzle.db

# Comma-separated origins allowed to call the API. Default covers Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How far back to look, in hours. 24 matches Nuzzle's original window.
WINDOW_HOURS=24

# Max posts to pull per refresh. Safety valve — a typical timeline
# pulls ~500-3000 posts over 24h.
MAX_POSTS_PER_REFRESH=5000

# Max results to return from /trending.
DEFAULT_TRENDING_LIMIT=50

# Minimum distinct sharers required for a link to appear.
MIN_SHARERS=2
